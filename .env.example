# ===== DeepSeek API (opcional — modo híbrido do assistente) =====
# Copie este arquivo para .env e preencha. O .env NÃO é versionado.
# Sem a chave, o assistente funciona 100% no modo local (Ollama).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== Ollama local (padrão) =====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=hospitaltech
